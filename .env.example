# GROQ_API_KEY: Primary fast free-tier LLM provider (https://console.groq.com/keys).
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Secondary fallback LLM provider (https://openrouter.ai/keys).
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Additional AI provider & RAG embeddings (Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLOUDFLARE_API_TOKEN & CLOUDFLARE_ACCOUNT_ID: Optional Cloudflare Workers AI provider.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for Webhouse AI Admin (/admin).
ADMIN_PASSCODE=""

# SESSION_SECRET: Optional 16+ char secret for signing admin session tokens across restarts.
SESSION_SECRET=""

# CREDENTIALS_ENCRYPTION_KEY: Optional 32-char secret for encrypting admin-entered provider keys in SQLite.
CREDENTIALS_ENCRYPTION_KEY=""
